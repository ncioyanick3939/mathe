    const rows = TOPICS.map((t) => {
      const st = data.topics[t.id] || { n: 0, ok: 0 }; const pc = st.n ? Math.round((st.ok / st.n) * 100) : 0;
      return '<button class="row" data-act="topic" data-id="' + t.id + '"><span class="dot" style="background:' + t.color + '"></span><span><span class="t">' + esc(t.name) + '</span><span class="meter" style="display:block"><i style="width:' + pc + '%;display:block"></i></span></span><span class="m">' + (st.n ? st.ok + '/' + st.n : 'neu') + '</span></button>';
    }).join('');
    $app.innerHTML =
      '<h1>Mathe-Training</h1><p class="sub">Algebra-Prüfung, 11 Themen. Jede Aufgabe ist neu, mit Lösungsweg.</p>' +
      '<div class="stats"><div class="stat"><b>' + data.total + '</b><span>Gelöst</span></div><div class="stat"><b>' + acc + '</b><span>Richtig</span></div><div class="stat"><b>' + data.streak + '</b><span>Serie (Best ' + data.best + ')</span></div></div>' +
      '<div class="stack"><button class="btn primary" data-act="mix">Gemischt üben, endlos</button>' +
      '<div class="grid2"><button class="btn" data-act="exam">Prüfungs-Simulation (15)</button><button class="btn" data-act="review"' + (data.wrong.length ? '' : ' disabled') + '>Fehler wiederholen (' + data.wrong.length + ')</button></div></div>' +
      '<h2 style="margin-top:22px">Nach Thema üben</h2><div class="topics">' + rows + '</div>' +
      '<p class="small muted" style="margin-top:18px">Eingabe: Hochzahl mit ^ (x^2), Bruch mit / und Klammern: (3a^2)/(4b^3). Die Symbolleiste hilft beim Tippen.</p>' +
      '<button class="linkbtn" data-act="reset">Statistik zurücksetzen</button>';
  }

  /* ---------- Sitzung ---------- */
  function start(mode, topic) {
    S = { mode, topic, idx: 0, ok: 0, n: 0, results: [], queue: null };
    if (mode === 'exam') S.queue = EXAM.map((x) => ({ t: x[0], sub: x[1], seed: rnd() }));
    if (mode === 'review') S.queue = data.wrong.map((w) => Object.assign({}, w));
    next(true);
  }
  function pickTopic() {
    const w = TOPICS.map((t) => { const s = data.topics[t.id]; const n = s ? s.n : 0; const acc = n ? s.ok / n : 0.5; return 1 + 3 * (1 - acc) + (n < 3 ? 1.5 : 0); });
    let r = Math.random() * w.reduce((a, b) => a + b, 0);
    for (let i = 0; i < w.length; i++) { r -= w[i]; if (r <= 0) return TOPICS[i].id; }
    return TOPICS[0].id;
  }
  function next(first) {
    if (!first && S.queue) S.idx++;
    let spec;
    if (S.queue) { if (S.idx >= S.queue.length) return summary(); spec = S.queue[S.idx]; }
    else spec = { t: S.mode === 'topic' ? S.topic : pickTopic(), seed: rnd(), sub: null };
    S.spec = spec; S.p = makeProblem(spec.t, spec.seed, spec.sub == null ? undefined : spec.sub);
    S.phase = 'ask'; S.counted = false; S.msg = ''; S.hint = false; S.pick = -1; S.each = null;
    render(); window.scrollTo(0, 0);
    const a = document.getElementById('ans0'); if (a && !('ontouchstart' in window)) a.focus();
  }
  function record(ok) {
    if (S.counted) return; S.counted = true;
    const id = S.p.topic; const tp = data.topics[id] || (data.topics[id] = { n: 0, ok: 0 });
    tp.n++; data.total++; S.n++;
    if (ok) { tp.ok++; data.ok++; data.streak++; S.ok++; data.best = Math.max(data.best, data.streak); } else data.streak = 0;
    S.results.push({ t: id, ok });
    const same = (w) => w.t === S.spec.t && w.seed === S.spec.seed;
    if (!ok) { if (!data.wrong.some(same)) data.wrong.unshift({ t: S.spec.t, seed: S.spec.seed, sub: S.spec.sub == null ? null : S.spec.sub }); data.wrong = data.wrong.slice(0, 60); }
    else if (S.mode === 'review') data.wrong = data.wrong.filter((w) => !same(w));
    save();
  }

  /* ---------- Ansicht: Aufgabe ---------- */
  const HELP = {
    mono: 'Schreibe z. B. 9/m^8 oder 9m^-8. Bei Brüchen Zähler und Nenner in Klammern: (3a^2)/(4b^3).',
    poly: 'Hochzahl mit ^, z. B. 4x^2 + 3x - 6. Alles ausmultipliziert und zusammengefasst.',
    factor: 'Mit Klammern schreiben, z. B. 3x(x+2) oder (a+2)(b-3).',
    ratfun: 'Bruch mit Klammern, z. B. (x-3)/2.',
    num: 'Zahl oder Bruch, z. B. 13/36 oder 0.25.',
    money: 'Zahl mit Dezimalpunkt, z. B. 101.15.',
    exact: 'Nur Ziffern und Dezimalpunkt, z. B. 0.000094172.',
    sci: 'Form: 8.14*10^-4',
    multi: 'Zahl mit Dezimalpunkt, auf Cent genau.',
  };
  function fieldsHTML(p, disabled) {
    const fs = p.kind === 'multi' ? p.fields : [{ label: 'Deine Antwort', unit: p.unit }];
    return fs.map((f, i) => '<div class="field"><label for="ans' + i + '">' + esc(f.label) + '</label><div class="inwrap"><input type="text" id="ans' + i + '" data-i="' + i + '" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="done"' + (disabled ? ' disabled' : '') + ' value="' + esc((S.vals && S.vals[i]) || '') + '">' + (f.unit ? '<span class="unit">' + esc(f.unit) + '</span>' : '') + '</div></div>').join('');
  }
  function keysHTML(p) {
    const base = ['^', '/', '(', ')', '·', '+', '−', '.'];
    const vs = [...new Set(p.vars || [])];
    const keys = (p.kind === 'multi' || p.kind === 'money' || p.kind === 'exact') ? ['.', '−'] : (p.kind === 'num' ? ['/', '.', '−', '(', ')', '^'] : base.concat(vs));
    return '<div class="keys" aria-label="Symbolleiste">' + keys.map((k) => '<button type="button" class="key" data-act="ins" data-k="' + k + '">' + k + '</button>').join('') + '<button type="button" class="key" data-act="del" aria-label="Löschen">⌫</button></div>';
  }
  function optionsHTML(p) {
    return '<div class="opts ' + p.kind + '">' + p.options.map((o, i) => {
      let cls = 'opt'; if (S.phase === 'done') { if (i === p.correct) cls += ' right'; else if (i === S.pick) cls += ' wrong'; }
      return '<button class="' + cls + '" data-act="pick" data-i="' + i + '"' + (S.phase === 'done' ? ' disabled' : '') + '>' + (p.kind === 'mc' ? '<b>' + 'ABCD'[i] + '</b><span class="math sm">' + o + '</span>' : '<span>' + o + '</span>') + '</button>';
    }).join('') + '</div>';
  }
  function render() {
    const p = S.p; const isChoice = p.kind === 'tf' || p.kind === 'mc';
    const t = T(p.topic); const exam = S.mode === 'exam';
    const title = exam ? 'Aufgabe ' + (S.idx + 1) + ' von ' + S.queue.length : (S.mode === 'review' ? 'Fehler wiederholen' : (S.mode === 'mix' ? 'Gemischt' : t.name));
    let h = '<div class="bar"><button class="btn ghost back" data-act="home" aria-label="Zurück zur Übersicht">←</button><div class="ttl">' + esc(title) + '</div><div class="score">' + S.ok + ' / ' + S.n + '</div></div>';
    if (S.queue) h += '<div class="prog" aria-hidden="true"><i style="width:' + Math.round((S.idx / S.queue.length) * 100) + '%"></i></div>';
    h += '<div class="card">' + (S.mode === 'mix' || S.mode === 'review' || exam ? '<div class="small muted" style="margin-bottom:6px">' + esc(t.short) + '</div>' : '') + p.html;
    if (isChoice) h += optionsHTML(p); else h += fieldsHTML(p, S.phase === 'done') + (S.phase === 'done' ? '' : keysHTML(p) + '<p class="help">' + esc(HELP[p.kind] || '') + '</p>');
    if (S.hint && S.phase !== 'done') h += '<div class="hint"><b>Tipp:</b> ' + p.hint + '</div>';
    h += '</div>';
    if (S.phase === 'ask' && S.msg) h += '<div class="res bad" role="alert">Noch nicht richtig<small>' + esc(S.msg) + '</small></div>';
    if (S.phase === 'done') {
      const good = S.lastOk;
      h += '<div class="res ' + (good ? 'ok' : 'bad') + '" role="status">' + (good ? (S.counted && S.firstOk === false ? 'Jetzt stimmt es' : 'Richtig') : 'Nicht ganz') + (S.msg && !good ? '<small>' + esc(S.msg) + '</small>' : '') + '</div>';
      h += '<div class="card"><h2>' + (good ? 'So geht der Lösungsweg' : 'Lösung und Lösungsweg') + '</h2><p class="ans">Richtig ist: <span class="math">' + p.ansHtml + '</span></p><ol class="steps">' + p.steps.map((s) => '<li>' + s + '</li>').join('') + '</ol></div>';
      h += '<button class="btn primary" data-act="next" id="nextbtn">' + (exam && S.idx === S.queue.length - 1 ? 'Auswertung' : (S.queue && S.idx === S.queue.length - 1 ? 'Fertig' : 'Nächste Aufgabe')) + '</button>';
    } else {
      h += '<div class="grid2">' + (S.hint ? '<button class="btn" data-act="solve">Lösung zeigen</button>' : (exam ? '<button class="btn" data-act="solve">Überspringen</button>' : '<button class="btn" data-act="hint">Tipp</button>')) + (isChoice ? '<button class="btn" data-act="solve">Lösung zeigen</button>' : '<button class="btn primary" data-act="check">Prüfen</button>') + '</div>';
    }
    $app.innerHTML = h;
  }
  function readVals() {
    const n = S.p.kind === 'multi' ? S.p.fields.length : 1; const v = [];
    for (let i = 0; i < n; i++) { const el = document.getElementById('ans' + i); v.push(el ? el.value : ''); }
    return v;
  }
  function check() {
    const p = S.p; S.vals = readVals();
    if (S.vals.every((x) => !x.trim())) { S.msg = 'Gib zuerst eine Antwort ein.'; render(); return; }
    const res = checkAnswer(p, p.kind === 'multi' ? S.vals : S.vals[0]);
    if (res.ok) { S.firstOk = !S.counted; record(true); S.lastOk = true; S.phase = 'done'; S.msg = ''; render(); scrollRes(); }
    else { if (!S.counted) { S.firstOk = false; record(false); } S.msg = res.msg || 'Das stimmt noch nicht.'; render(); scrollRes(); const a = document.getElementById('ans0'); if (a) a.focus(); }
  }
  function scrollRes() { const el = document.querySelector('.res'); if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
  function solve() { if (S.p.kind !== 'tf' && S.p.kind !== 'mc') S.vals = readVals(); if (!S.counted) { S.firstOk = false; record(false); } S.lastOk = false; S.phase = 'done'; S.msg = ''; render(); scrollRes(); }
  function pickOpt(i) {
    if (S.phase === 'done') return; S.pick = i; const ok = i === S.p.correct; record(ok); S.firstOk = ok; S.lastOk = ok; S.phase = 'done'; render(); scrollRes();
  }

  /* ---------- Auswertung ---------- */
  function summary() {
    const n = S.results.length, ok = S.results.filter((r) => r.ok).length; const pc = n ? Math.round((ok / n) * 100) : 0;
    const by = {}; S.results.forEach((r) => { (by[r.t] = by[r.t] || []).push(r.ok); });
    const rows = Object.keys(by).map((id) => '<div class="sumrow"><span>' + esc(T(id).name) + '</span><b>' + by[id].filter(Boolean).length + ' / ' + by[id].length + '</b></div>').join('');
    const msg = pc >= 85 ? 'Sehr stark.' : pc >= 60 ? 'Solide. Die roten Themen nochmals üben.' : 'Noch Luft nach oben. Übe die Themen unten einzeln.';
    $app.innerHTML = '<div class="bar"><button class="btn ghost back" data-act="home" aria-label="Zurück">←</button><div class="ttl">Auswertung</div></div><div class="card"><div class="big">' + ok + ' / ' + n + '</div><p class="muted" style="margin:4px 0 12px">' + pc + ' % richtig. ' + msg + '</p>' + rows + '</div><div class="stack"><button class="btn primary" data-act="' + (S.mode === 'review' ? 'review' : 'exam') + '">Nochmal</button><button class="btn" data-act="home">Zur Übersicht</button></div>';
    window.scrollTo(0, 0);
  }

  /* ---------- Ereignisse ---------- */
  document.addEventListener('focusin', (e) => { if (e.target && e.target.matches && e.target.matches('input[type=text]')) lastInput = e.target; });
  $app.addEventListener('pointerdown', (e) => { if (e.target.closest && e.target.closest('.key')) e.preventDefault(); });
  $app.addEventListener('click', (e) => {
    const b = e.target.closest('[data-act]'); if (!b || b.disabled) return; const a = b.dataset.act;
    if (a === 'topic') start('topic', b.dataset.id);
    else if (a === 'mix') start('mix');
    else if (a === 'exam') start('exam');
    else if (a === 'review') { if (data.wrong.length) start('review'); }
    else if (a === 'home') home();
    else if (a === 'next') next();
    else if (a === 'check') check();
    else if (a === 'solve') solve();
    else if (a === 'hint') { S.hint = true; S.vals = readVals(); render(); }
    else if (a === 'pick') pickOpt(Number(b.dataset.i));
    else if (a === 'ins' || a === 'del') {
      const el = (lastInput && document.body.contains(lastInput)) ? lastInput : document.getElementById('ans0'); if (!el) return;
      el.focus(); const s = el.selectionStart == null ? el.value.length : el.selectionStart, en = el.selectionEnd == null ? s : el.selectionEnd;
      if (a === 'ins') { const k = b.dataset.k; el.value = el.value.slice(0, s) + k + el.value.slice(en); el.setSelectionRange(s + k.length, s + k.length); }
      else if (s !== en) { el.value = el.value.slice(0, s) + el.value.slice(en); el.setSelectionRange(s, s); }
      else if (s > 0) { el.value = el.value.slice(0, s - 1) + el.value.slice(s); el.setSelectionRange(s - 1, s - 1); }
    }
    else if (a === 'reset') { if (b.dataset.sure) { data = { total: 0, ok: 0, streak: 0, best: 0, topics: {}, wrong: [] }; save(); home(); } else { b.dataset.sure = '1'; b.textContent = 'Wirklich löschen? Nochmals tippen.'; } }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || !S || !S.p) return;
    if (S.phase === 'done') { const nb = document.getElementById('nextbtn'); if (nb) { e.preventDefault(); next(); } }
    else if (e.target && e.target.matches && e.target.matches('input[type=text]')) {
      e.preventDefault(); const i = Number(e.target.dataset.i || 0); const nx = document.getElementById('ans' + (i + 1));
      if (nx) nx.focus(); else check();
    }
  });
  home();
  window.__mt = { start, home, get S() { return S; } };
})();

})();
</script>
</body></html>
