    case 'tf': case 'mc': return { ok: Number(input) === p.correct };
    case 'multi': { const res = p.fields.map((f, i) => checkNum(input[i] || '', f.answer, f.tol)); return { ok: res.every((r) => r.ok), each: res.map((r) => r.ok), msg: (res.find((r) => !r.ok) || {}).msg }; }
